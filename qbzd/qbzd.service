# qbzd.service — Qobuz Connect daemon (system unit for Infigo streamers)
#
# Runs as the 'music' user; Qobuz credentials come from a one-time
# `qbzd login` performed as that user. Managed by the Infigo control page
# ("Qobuz Connect" operating mode).
[Unit]
Description=Qobuz Connect daemon (qbzd)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=music
Group=audio
# Pin to the isolated audio core (nohz_full CPU): the highest CPU number —
# 3 on quad-core units, 7 on octa-core units. ($$ is systemd's escape for $.)
ExecStart=/usr/bin/sh -c 'exec /usr/bin/taskset -c $$(($$(/usr/bin/getconf _NPROCESSORS_CONF) - 1)) /usr/bin/qbzd run'
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
