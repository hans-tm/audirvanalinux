[Unit]
Description=Run audirvanaStudio
DefaultDependencies=no
Requires=sound.target
After=sound.target

[Service]
Type=simple
WorkingDirectory=/opt/audirvana/studio
# Pin to the isolated audio core (highest CPU: 3 on quad-core, 7 on octa-core).
# ($$ is systemd's escape for a literal $.)
ExecStart=/usr/bin/sh -c 'exec /usr/bin/taskset -c $$(($$(/usr/bin/getconf _NPROCESSORS_CONF) - 1)) /opt/audirvana/studio/audirvanaStudio'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
